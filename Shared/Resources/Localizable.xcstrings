    "calorie_tdee": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtumsatz (TDEE)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total Daily Energy"
          }
        }
      }
    },
    "calorie_tdee_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gesamtumsatz (TDEE = Total Daily Energy Expenditure) ist dein gesamter täglicher Kalorienverbrauch inklusive Bewegung. Er wird berechnet, indem dein Grundumsatz mit einem Aktivitätsfaktor (PAL-Wert) multipliziert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Total Daily Energy Expenditure (TDEE) is the total number of calories you burn per day including physical activity. It is calculated by multiplying your BMR by a Physical Activity Level (PAL) factor."
          }
        }
      }
    },
    "calorie_week_short": {
      "localizations": {
