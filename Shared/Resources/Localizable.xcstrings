            "value": "Set calorie goal automatically"
          }
        }
      }
    },
    "calorie_bmr": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grundumsatz (BMR)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basal Metabolic Rate"
          }
        }
      }
    },
    "calorie_bmr_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Grundumsatz (BMR = Basal Metabolic Rate) ist die Energie, die dein Körper im Ruhezustand verbraucht — für Atmung, Herzschlag, Organfunktionen und Zellstoffwechsel. Er wird aus Gewicht, Größe, Alter und Geschlecht berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Basal Metabolic Rate (BMR) is the energy your body uses at complete rest — for breathing, heartbeat, organ function and cell metabolism. It is calculated from weight, height, age and sex."
          }
        }
      }
    },
    "calorie_bonus_formula": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonus = max(0, Apple Watch Aktivität − erwartete Aktivität)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonus = max(0, Apple Watch activity − expected activity)"
          }
        }
      }
    },
    "calorie_clamped_to_minimum": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherheitsminimum:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety minimum:"
          }
        }
      }
    },
    "calorie_day_short": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "day"
          }
        }
      }
    },
    "calorie_deficit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagesdefizit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily Deficit"
          }
        }
      }
    },
    "calorie_deficit_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Gewicht zu verlieren, musst du weniger Kalorien zu dir nehmen als du verbrauchst. 1 kg Körperfett entspricht ca. 7.700 kcal. Das Tagesdefizit ergibt sich aus deinem Wochenziel geteilt durch 7 Tage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To lose weight, you need to consume fewer calories than you burn. 1 kg of body fat equals approx. 7,700 kcal. The daily deficit is derived from your weekly goal divided by 7 days."
          }
        }
      }
    },
    "calorie_formula_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mifflin-St-Jeor-Gleichung (1990) gilt als eine der genauesten Formeln zur Berechnung des Grundumsatzes. Sie wurde in zahlreichen Studien validiert und wird von der Academy of Nutrition and Dietetics empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mifflin-St Jeor equation (1990) is considered one of the most accurate formulas for estimating basal metabolic rate. It has been validated in numerous studies and is recommended by the Academy of Nutrition and Dietetics."
          }
        }
      }
    },
    "calorie_formula_name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formel: Mifflin-St-Jeor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formula: Mifflin-St Jeor"
          }
        }
      }
    },
    "calorie_goal_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kalorienziel ist der Gesamtumsatz abzüglich des Tagesdefizits. Es wird nie unter das Sicherheitsminimum gesenkt (1.500 kcal für Männer, 1.200 kcal für Frauen), um eine gesunde Versorgung sicherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your calorie goal is your TDEE minus the daily deficit. It is never lowered below the safety minimum (1,500 kcal for men, 1,200 kcal for women) to ensure adequate nutrition."
          }
        }
      }
    },
    "calorie_healthkit_bonus": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch Bonus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch Bonus"
          }
        }
      }
    },
    "calorie_healthkit_bonus_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei aktivierter Apple Watch wird dein Kalorienziel nur dann erhöht, wenn deine tatsächliche Bewegungsenergie die im Aktivitätsfaktor bereits enthaltene Aktivität übersteigt. So wird keine Aktivität doppelt gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Apple Watch enabled, your calorie goal is only increased when your actual movement energy exceeds the activity already included in the activity factor. This prevents double-counting activity."
          }
        }
      }
    },
    "calorie_pal_activity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwartete Aktivität (PAL)"
          }
        },
        "en": {
